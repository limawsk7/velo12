# Velo — configuração da sua própria instalação
# Frontend: configure também estas variáveis no provedor de hospedagem.
# A chave publishable/anon é pública por definição; NUNCA coloque service_role aqui.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_DISABLE_SUPABASE=false

# Opcional: apenas para executar Edge Functions locais durante desenvolvimento.
# Deixe vazio em produção. O client só aceita localhost/127.0.0.1.
VITE_SUPABASE_FUNCTIONS_URL=
VITE_LOCAL_FUNCTIONS=

# Segredos de BACKEND — cadastrar no Supabase Edge Function Secrets ou no servidor.
# Não prefixar com VITE_ e não enviar para o GitHub.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
PAGEPILOT_API_KEY=
PAGEPILOT_API_BASE_URL=https://app.pagepilot.ai

# Credenciais de integrações (backend only; preencher somente as que usar).
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=
VALIDAPAY_API_KEY=
GEMINI_API_KEY=
